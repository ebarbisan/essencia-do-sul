generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(REVENDEDOR)
  createdAt     DateTime  @default(now())
  accessEnabled Boolean   @default(false)
  sessions      Session[]
}

model RevendedorRequest {
  id        Int           @id @default(autoincrement())
  nome      String
  documento String
  cidade    String
  contato   String
  mensagem  String?
  status    RequestStatus @default(PENDENTE)
  createdAt DateTime      @default(now())
}

model Product {
  id       Int     @id @default(autoincrement())
  title    String
  slug     String  @unique
  desc     String?
  image    String?
  featured Boolean @default(false)
}

model Session {
  tokenHash String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  REVENDEDOR
}

enum RequestStatus {
  PENDENTE
  APROVADO
  REJEITADO
}
